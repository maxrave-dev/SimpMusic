<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget labels and descriptions live here, not in composeResources: the entries in res/xml
  reference them as @string/… and only Android resources resolve there. Not on Crowdin as a
  result — these are the few strings the picker reads before any Compose code runs.
-->
<resources>
    <string name="widget_turntable_label">Turntable</string>
    <string name="widget_turntable_description">Album art with play and skip</string>
    <string name="widget_playlists_label">Playlists</string>
    <string name="widget_playlists_description">Now playing with controls, over your recently added</string>
    <string name="widget_insights_label">Listening insights</string>
    <string name="widget_insights_description">Listening time, play count and your 30-day top songs and artists</string>
    <string name="widget_insights_time">listening time</string>
    <string name="widget_insights_plays">plays</string>
    <string name="widget_insights_top_songs">Top songs · 30 days</string>
    <string name="widget_insights_top_artists">Top artists · 30 days</string>
    <string name="widget_recently_added">Recently added</string>
</resources>
