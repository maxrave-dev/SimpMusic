<?xml version="1.0" encoding="utf-8"?>
<!-- See widget_preview_img_turntable for why these exist. Two bands: player over strip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141317" />
            <corners android:radius="18dp" />
            <size android:width="250dp" android:height="130dp" />
        </shape>
    </item>
    <item android:height="62dp" android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="#1C1B1F" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:left="12dp"
        android:top="11dp"
        android:gravity="top|left">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
