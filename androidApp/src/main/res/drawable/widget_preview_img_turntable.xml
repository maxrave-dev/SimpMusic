<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1B1F" />
            <corners android:radius="18dp" />
            <size android:width="160dp" android:height="160dp" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#2B2938" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:bottom="14dp"
        android:drawable="@drawable/widget_preview_library_music_24"
        android:gravity="center" />
    <item
        android:width="112dp"
        android:height="36dp"
        android:bottom="16dp"
        android:gravity="center_horizontal|bottom">
        <shape android:shape="rectangle">
            <solid android:color="#99141318" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="18dp"
        android:bottom="25dp"
        android:drawable="@drawable/rounded_fast_rewind_24"
        android:gravity="left|bottom"
        android:left="36dp" />
    <item
        android:width="28dp"
        android:height="28dp"
        android:bottom="20dp"
        android:gravity="center_horizontal|bottom">
        <shape android:shape="oval">
            <solid android:color="#6750A4" />
        </shape>
    </item>
    <item
        android:width="16dp"
        android:height="16dp"
        android:bottom="26dp"
        android:drawable="@drawable/rounded_play_arrow_24"
        android:gravity="center_horizontal|bottom" />
    <item
        android:width="18dp"
        android:height="18dp"
        android:bottom="25dp"
        android:drawable="@drawable/rounded_fast_forward_24"
        android:gravity="right|bottom"
        android:right="36dp" />
</layer-list>
